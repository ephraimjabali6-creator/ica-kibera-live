# ICA website — copy to .env.local (local) or your host's environment settings.

# Public URL (used for canonical links, sitemap and link previews)
NEXT_PUBLIC_SITE_URL=https://ica.or.ke

# Admin area (/admin). Use a long random password and a 32+ character secret.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Email notifications (Resend). FROM must be on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ICA <hello@ica.or.ke>
NOTIFY_EMAIL=
PRAYER_TEAM_EMAIL=

# PostgreSQL (recommended in production). Without it, data lives in memory and resets on restart.
DATABASE_URL=

# Salt for anonymous visitor counting (any random string)
ANALYTICS_SALT=

# Extra origins allowed to POST to the API (comma separated), e.g. a staging domain
ALLOWED_ORIGINS=
